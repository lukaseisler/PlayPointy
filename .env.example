# Supabase (Project Settings → API)
# Browser keys are also baked into src/lib/supabase/publicConfig.ts for Cloudflare.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: unlocks packs after Stripe payment (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: canonical site URL for share links + Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Dashboard → Developers → API keys) — Test mode first
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From Stripe CLI (`stripe listen`) or Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
