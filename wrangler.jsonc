{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "playpointy",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Cloudflare Pages Output nach `npm run pages:build`
	"pages_build_output_dir": ".open-next"
	// KEIN `assets.binding: "ASSETS"` — in Pages reserviert (Platform stellt es bereit).
	// KEIN `services.WORKER_SELF_REFERENCE` — verweist auf Worker "playpointy",
	// der bei Pages-Erstdeploys nicht existiert und den Build abbricht.
	// Self-Reference wird erst fuer OpenNext-Caching/Queue benoetigt (R2 etc.).
}
