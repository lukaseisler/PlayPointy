{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "playpointy",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Cloudflare Pages Output nach `npm run pages:build`
	"pages_build_output_dir": ".open-next",
	// KEIN `assets.binding: "ASSETS"` — der Name ist in Pages-Projekten
	// reserviert (Platform stellt ASSETS automatisch bereit). Explizites
	// Binding blockiert den Build mit:
	// "The name 'ASSETS' is reserved in Pages projects."
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "playpointy"
		}
	]
}
